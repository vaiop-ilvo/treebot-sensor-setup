    // IntelliSense: use the exact flags of the CMake build (build/compile_commands.json),
    // with explicit include paths as fallback for headers that are not in the compile database
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.cppStandard": "c++23",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/thirdparty/Galaxy_camera/inc",
        "${workspaceFolder}/thirdparty/boost_1_84_0_install/include",
        "/usr/include/opencv4",
        "/usr/include/x86_64-linux-gnu/qt5",
        "/usr/include/x86_64-linux-gnu/qt5/QtCore",
        "/usr/include/x86_64-linux-gnu/qt5/QtGui",
        "/usr/include/x86_64-linux-gnu/qt5/QtWidgets",
        "/usr/include/x86_64-linux-gnu/qt5/QtOpenGL",
        "/usr/include/eigen3",
        "/usr/include/pcl-1.14",
        "/usr/local/include"
    ],
    "C_Cpp.default.defines": [
        "QT_CORE_LIB",
        "QT_GUI_LIB",
        "QT_WIDGETS_LIB",
        "QT_OPENGL_LIB",
        "BOOST_ALLOW_DEPRECATED_HEADERS",
        "BOOST_BIND_GLOBAL_PLACEHOLDERS"
    ],
    "license-header-manager.additionalCommentStyles": [
        {
            "extension": ".cpp",
            "commentStart": " /*",
            "commentMiddle": " * ",
            "commentEnd": " */"
        },
        {
            "extension": ".h",
            "commentStart": " /*",
            "commentMiddle": " * ",
            "commentEnd": " */"
        },
        {
            "extension": ".txt",
            "commentStart": "###",
            "commentMiddle": "#",
            "commentEnd": "###"
        },
        {
            "extension": ".sh",
            "commentStart": "###",
            "commentMiddle": "#",
            "commentEnd": "###"
        }
    ],
    "license-header-manager.excludeFolders": [
        "opcua", 
        "opc"
    ]
